<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The two declarations that decide whether this is a TV app at all.
         A TV box has no touchscreen, so an app that does not explicitly say
         it can live without one is filtered out of the Android TV launcher
         entirely; leanback stays required=false so the same APK still
         installs on a phone or tablet for testing. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HalcyonTv">

        <!-- The store stream. LEANBACK_LAUNCHER is the TV tile; plain LAUNCHER
             keeps it reachable on a phone and on Fire OS launchers that read
             the classic category.

             No android:screenOrientation here on purpose. A television is
             landscape already and ignores it, but declaring it makes aapt
             imply a `android.hardware.screen.landscape` feature requirement,
             which is a filter some TV devices fail. Verify with
             `aapt2 dump badging` after any manifest change: the only
             uses-feature lines should be the two not-required ones above. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HalcyonTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where you type the store's address. Not a launcher entry: you
             reach it by long-pressing BACK, or automatically when there is no
             address saved yet. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation"
            android:theme="@style/Theme.HalcyonTv" />

    </application>

</manifest>
