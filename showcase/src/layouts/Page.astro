---
import { snapshot } from '../catalog/load';
interface Props { title: string; description?: string; }
const { title, description = 'Discover a curated selection of movies and series with Halcyon Video.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>{title} · Halcyon Video</title><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" />{canonical && <link rel="canonical" href={canonical} />}</head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/">HALCYON <span>VIDEO</span></a><nav aria-label="Main"><a href="/browse/">Browse</a><a href="/about/">About</a><a href="/store/">3D store</a></nav></header><main id="main"><p class="preview">Development preview · fictional sample titles</p><slot /></main><footer><p>Curated selection · United States</p><p>Fixture date: {snapshot.checkedAt.slice(0, 10)} · No live availability claims</p><a href="/self-host/">Make it your own</a></footer></body></html>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#eff3f8;background:#0d1727;font-synthesis:none;color-scheme:dark;line-height:1.6}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:.25em}a:focus-visible,summary:focus-visible{outline:3px solid #f9d481;outline-offset:4px}header,main,footer{max-width:64rem;margin:auto;padding:1.3rem}header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid #40516b}.brand{font-weight:900;font-size:1.2rem;letter-spacing:.12em;text-decoration:none}.brand span{color:#9ecaff}nav{display:flex;flex-wrap:wrap;gap:1.1rem}nav a,footer a,.button{display:inline-flex;min-height:44px;align-items:center}h1{font-family:Georgia,serif;font-size:clamp(2rem,7vw,3.7rem);line-height:1.12;max-width:16ch;font-weight:500}h2{font-size:1.3rem}.lead{color:#c3cedd;max-width:42rem}.preview{font-size:1rem;color:#f9d481}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:1.25rem;padding:0;list-style:none;max-width:38rem}.card{text-decoration:none;display:block}.poster{aspect-ratio:2/3;background:#203650;border:1px solid #506a87;display:flex;align-items:center;justify-content:center;text-align:center;padding:1rem;font-family:Georgia,serif;font-size:1.5rem}.meta{color:#b4c4d7}footer{border-top:1px solid #40516b;margin-top:3rem;font-size:1rem}summary{cursor:pointer;min-height:44px;padding:.5rem 0}.skip{position:absolute;top:-5rem;left:1rem}.skip:focus{top:.5rem;background:#0d1727;padding:.6rem}.button{background:#e3edfa;color:#162840;padding:.5rem 1rem;border-radius:3px;text-decoration:none}p{max-width:65ch}
</style>
