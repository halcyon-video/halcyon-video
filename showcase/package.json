    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
