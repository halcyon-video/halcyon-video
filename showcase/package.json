{
  "name": "halcyon-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:artifact",
    "test:artifact": "node --test tests/artifact.test.mjs",
    "test:browser": "playwright test",
    "package:preview": "node --experimental-strip-types tools/package-preview.ts",
    "readiness:report": "node --experimental-strip-types tools/readiness-report.ts",
    "deployment:plan": "node --experimental-strip-types tools/deployment-plan.ts",
    "publish:fixture": "node --experimental-strip-types tools/publish-fixture.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0"
  }
}
